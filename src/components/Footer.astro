---
import themeSource from "../data/theme-source.json";

const year = new Date().getFullYear();
const songUrl = themeSource.songId != null ? `https://vocadb.net/S/${themeSource.songId}` : null;
---

<footer class="site-footer">
  <div class="container">
    {
      themeSource.songName && songUrl && (
        <p class="theme-credit">
          theme by <a href={songUrl} target="_blank" rel="noopener noreferrer">{themeSource.songName}</a>
        </p>
      )
    }
    <small>&copy; {year} henohenon</small>
  </div>
</footer>
