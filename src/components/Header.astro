---
const siteTitle = "へのへのんのの";
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand">{siteTitle}</a>
    <nav>
      <a
        href="https://x.com/henohenon_8282"
        class="icon-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (@henohenon_8282)"
      >
        <img src="/icons/x/logo.svg" alt="" width="20" height="20" />
      </a>
      <a
        href="https://github.com/henohenon"
        class="icon-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub (henohenon)"
      >
        <img src="/icons/github/github-mark.svg" alt="" width="20" height="20" />
      </a>
    </nav>
  </div>
</header>
